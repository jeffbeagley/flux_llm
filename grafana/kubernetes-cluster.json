      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(k8s_pod_phase{k8s_namespace_name=~\"$namespace\",k8s_node_name=~\"$node\"}, k8s_pod_name)",
        "query": { "query": "label_values(k8s_pod_phase{k8s_namespace_name=~\"$namespace\",k8s_node_name=~\"$node\"}, k8s_pod_name)", "refId": "Prometheus-pod" },
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [],
        "refresh": 1,
        "regex": "",
