        "definition": "label_values(k8s_deployment_desired{k8s_namespace_name=~\"$namespace\"}, k8s_deployment_name)",
        "query": { "query": "label_values(k8s_deployment_desired{k8s_namespace_name=~\"$namespace\"}, k8s_deployment_name)", "refId": "Prometheus-deployment" },
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [],
